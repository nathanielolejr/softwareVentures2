# Resend (https://resend.com) – required for the contact form to send email
RESEND_API_KEY=
# Where inquiries are delivered
CONTACT_TO_EMAIL=venturessoftware609@gmail.com
# Verified sender, e.g. "Software Ventures <hello@yourdomain.com>". For testing: onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Optional: raises the GitHub API rate limit (public_repo read access is enough)
GITHUB_TOKEN=
# Canonical site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: set to "true" to enable Vercel Analytics
NEXT_PUBLIC_ENABLE_ANALYTICS=false
